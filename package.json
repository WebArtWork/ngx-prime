{
    "name": "@wawjs/ngx-prime-monorepo",
    "version": "22.0.5",
    "author": "Web Art Work",
    "description": "ngx-prime is an independent MIT-licensed Angular UI component library continuing from the ngx-prime v21.1.9 codebase.",
    "homepage": "https://github.com/WebArtWork/ngx-prime",
    "repository": {
        "type": "git",
        "url": "https://github.com/WebArtWork/ngx-prime.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/WebArtWork/ngx-prime/issues"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "setup": "npm run clean && npm run init",
        "clean": "npx rimraf --glob **/node_modules **/dist **/.angular",
        "init": "npm install && husky",
        "prepare": "husky",
        "link": "npm run dev:link --workspaces --if-present",
        "publish": "npm run build:release && npm publish --workspaces",
        "publish:dry-run": "npm run build:release && npm publish --workspaces --dry-run",
        "build": "cross-env NODE_ENV=production npm run build:check && npm run build:packages && npm run build:docs && npm run build:showcase",
        "build:release": "cross-env NODE_ENV=production npm run build:check && npm run build:packages",
        "build:check": "npm run format:check && npm run security:check",
        "build:packages": "npm run build:lib && npm run build:themes && npm run build:mcp",
        "build:lib": "npm run build --workspace=packages/ngx-prime",
        "build:themes": "npm run build --workspace=packages/themes",
        "build:mcp": "npm run build --workspace=packages/mcp",
        "build:showcase": "npm run build --workspace=apps/showcase",
        "build:docs": "npm run build:docs --workspace=apps/showcase",
        "dev": "npm run start --workspace=apps/showcase",
        "dev:ssr": "npm run start:ssr --workspace=apps/showcase",
        "security:check": "npm audit --omit=dev --audit-level=high",
        "format": "prettier --write \"packages/**/*.{js,mjs,ts,mts,d.ts,html}\" \"apps/**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
        "format:check": "prettier --check \"packages/**/*.{js,mjs,ts,mts,d.ts,html}\" \"apps/**/*.{js,mjs,ts,mts,d.ts,html}\""
    },
    "devDependencies": {
        "@angular/build": "22.1.6",
        "@angular-devkit/build-angular": "22.1.6",
        "@angular/animations": "22.1.4",
        "@angular/cli": "22.1.6",
        "@angular/common": "22.1.4",
        "@angular/compiler": "22.1.4",
        "@angular/compiler-cli": "22.1.4",
        "@angular/core": "22.1.4",
        "@angular/forms": "22.1.4",
        "@angular/cdk": "22.1.4",
        "@angular/platform-browser": "22.1.4",
        "@angular/platform-browser-dynamic": "22.1.4",
        "@angular/platform-server": "22.1.4",
        "@angular/router": "22.1.4",
        "@commitlint/cli": "^19.6.1",
        "@commitlint/config-conventional": "^19.6.0",
        "cross-env": "^7.0.3",
        "fs-extra": "^11.2.0",
        "glob": "^10.4.2",
        "husky": "^9.1.6",
        "lint-staged": "^12.0.0",
        "ng-packagr": "22.1.1",
        "prettier": "^3.0.0",
        "tsup": "^8.1.0",
        "typescript": "6.0.3"
    },
    "overrides": {
        "hono": ">=4.12.25",
        "fast-uri": ">=3.1.5",
        "ip-address": ">=10.3.1",
        "nanoid": ">=3.3.18",
        "postcss": ">=8.5.18"
    },
    "publishConfig": {
        "access": "public"
    },
    "lint-staged": {
        "packages/**/*.{js,mjs,mts,d.ts}": [
            "prettier --write"
        ],
        "apps/**/*.{js,mjs,mts,d.ts}": [
            "prettier --write"
        ]
    }
}
