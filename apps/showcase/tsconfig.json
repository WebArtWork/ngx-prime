{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "baseUrl": "./",
        "outDir": "./out-tsc/app",
        "types": ["node"],
        "strict": false,
        "paths": {
            "ngx-prime/*": ["../../packages/ngx-prime/src/*/public_api"],
            "@wawjs/css-prime-styled/*": ["../../../../packages/styled/dist/*"],
            "@wawjs/css-prime-styles/*": ["../../../../packages/styles/dist/*"],
            "@wawjs/css-prime-themes/*": ["../../../../packages/themes/dist/*"],
            "@wawjs/css-prime-utils/*": ["../../../../packages/utils/dist/*"],
            "@wawjs/css-prime-motion/*": ["../../../../packages/motion/dist/*"],

            "@/*": ["./*"]
        }
    },
    "include": ["../../packages/ngx-prime/src/**/*.d.ts", "../../node_modules/@wawjs/css-prime-styles/**/*.d.ts", "../../node_modules/@wawjs/css-prime-themes/**/*.d.ts"],
    "exclude": ["node_modules", "**/node_modules", "**/dist", "**/*.spec.ts", "**/*.test.ts"],
    "files": ["app/main.ts", "server/main.server.ts", "server/server.ts", "app/polyfills.ts"],
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": false,
        "strictInputAccessModifiers": false,
        "strictTemplates": false
    }
}
