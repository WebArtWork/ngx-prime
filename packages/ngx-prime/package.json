{
    "name": "primeng",
    "version": "22.0.0",
    "author": "Web Art Work",
    "description": "ngx-prime is an independent MIT-licensed Angular UI component library continuing from the PrimeNG v21.1.9 codebase.",
    "homepage": "https://github.com/WebArtWork/ngx-prime",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/WebArtWork/ngx-prime.git",
        "directory": "packages/ngx-prime"
    },
    "bugs": {
        "url": "https://github.com/WebArtWork/ngx-prime/issues"
    },
    "keywords": [
        "primeng",
        "angular",
        "ui library",
        "component library",
        "material",
        "bootstrap",
        "fluent",
        "tailwind"
    ],
    "publishConfig": {
        "directory": "dist",
        "linkDirectory": false,
        "access": "public"
    },
    "files": [
        "README.md",
        "LICENSE",
        "fesm2022",
        "types"
    ],
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:package": "pnpm run build:prebuild && ng build primeng && pnpm run build:postbuild",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "build:postbuild": "node ./scripts/postbuild.mjs",
        "dev:link": "pnpm link --global && npm link",
        "lint": "ng lint",
        "test:unit": "ng test primeng --watch=false --browsers=ChromeHeadless",
        "test:unit:watch": "ng test primeng",
        "test:unit:coverage": "ng test primeng --coverage"
    },
    "devDependencies": {
        "@types/jasmine": "~4.3.1",
        "chart.js": "4.4.2",
        "quill": "2.0.2",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "@angular/cdk": "^22.1.2",
        "@angular/common": "^22.1.2",
        "@angular/core": "^22.1.2",
        "@angular/forms": "^22.1.2",
        "@angular/router": "^22.1.2",
        "@angular/platform-browser": "^22.1.2",
        "rxjs": "^6.0.0 || ^7.8.1"
    },
    "dependencies": {
        "@wawjs/css-prime-styled": "^1.0.0",
        "@wawjs/css-prime-utils": "^1.0.0",
        "@wawjs/css-prime-styles": "^1.0.0",
        "@wawjs/css-prime-motion": "^1.0.0"
    }
}
