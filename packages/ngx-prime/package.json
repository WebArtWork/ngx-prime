{
    "name": "@wawjs/ngx-prime",
    "version": "22.0.5",
    "author": "Web Art Work",
    "description": "ngx-prime is an independent MIT-licensed Angular UI component library continuing from the ngx-prime v21.1.9 codebase.",
    "homepage": "https://github.com/WebArtWork/ngx-prime",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/WebArtWork/ngx-prime.git",
        "directory": "packages/ngx-prime"
    },
    "bugs": {
        "url": "https://github.com/WebArtWork/ngx-prime/issues"
    },
    "keywords": [
        "ngx-prime",
        "angular",
        "ui library",
        "component library",
        "material",
        "bootstrap",
        "fluent",
        "tailwind"
    ],
    "publishConfig": {
        "directory": "dist",
        "linkDirectory": false,
        "access": "public"
    },
    "files": [
        "README.md",
        "LICENSE",
        "fesm2022",
        "types"
    ],
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ npm run build:package",
        "build:package": "npm run build:prebuild && ng build ngx-prime && npm run build:postbuild",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "build:postbuild": "node ./scripts/postbuild.mjs",
        "dev:link": "npm link"
    },
    "devDependencies": {
        "@angular/aria": "22.1.5",
        "chart.js": "4.4.2",
        "quill": "2.0.2",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "@angular/aria": "22.1.5",
        "@angular/cdk": "22.1.5",
        "@angular/common": "22.1.5",
        "@angular/core": "22.1.5",
        "@angular/forms": "22.1.5",
        "@angular/router": "22.1.5",
        "@angular/platform-browser": "22.1.5",
        "rxjs": "^6.0.0 || ^7.8.1"
    },
    "dependencies": {
        "@wawjs/css-prime-styled": "^1.1.0",
        "@wawjs/css-prime-utils": "^1.1.0",
        "@wawjs/css-prime-styles": "^1.1.0",
        "@wawjs/css-prime-motion": "^1.1.0"
    }
}
